rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow each authenticated user to read/write their own profile document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to read groups and create new groups.
    // Updates/deletes remain restricted (requires moderation/roles later).
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title','desc','createdAt','owner'])
        && request.resource.data.title is string
        && request.resource.data.desc is string
        && request.resource.data.title.size() > 2
        && request.resource.data.title.size() < 80
        && request.resource.data.desc.size() < 500
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
